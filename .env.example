# Public (safe to expose to web build)
APP_ENV=development
APP_BASE_URL=http://localhost:5173
# Web-build API origin (Vite exposes only VITE_-prefixed vars to client code).
# Keep empty for local dev (Vite proxy serves /api) and same-origin previews;
# set only for split-origin builds, e.g. https://obcda-api.<domain> in production.
VITE_API_BASE_URL=

# Server only - values are placeholders. Real values go to Cloudflare Secrets / local .env (git-ignored).
DATABASE_URL=
# §9.1 admin 経路のアプリ層 JWT 検証（両方設定で有効化。例: myteam.cloudflareaccess.com / Access アプリの AUD タグ）
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# app_settings 暗号化 KEK（base64 32byte。`openssl rand -base64 32` で生成し wrangler secret へ）
SETTINGS_ENC_KEY=
# AI 日次トークン上限（input+output 合算/UTC 日。未設定 = 上限なし。到達時は根拠のみ回答へ縮退）
AI_DAILY_TOKEN_BUDGET=
# pages-worker の admin ホストガードで追加許可するホスト（カンマ区切り。例: preview.obcda-web.pages.dev）
ADMIN_EXTRA_HOSTS=
LLM_PROVIDER=
# LLM_MODEL は非推奨 — 実行時モデルは ANTHROPIC_MODEL を使用
LLM_MODEL=
# AI 回答キー（env が最優先）。未設定なら管理者画面（設定 → AI設定(Anthropic)）の保存値を使用
LLM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=
SOURCE_FETCH_ALLOWLIST=mlit.go.jp,nilim.go.jp,buildingsmart.org
AI_LOG_RETENTION_DAYS=7
